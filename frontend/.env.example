# ============================================================
# VAULTIS Frontend — .env.example
# Copy to .env (Vite reads VITE_-prefixed vars at build/dev time).
# ============================================================

# Base URL of the real backend — no mock data, no fallback.
VITE_API_BASE_URL=http://localhost:8000

# [DEPRECATED] The frontend now checks the backend's /demo-status endpoint 
# at runtime to show/hide the tamper button. This env var is no longer used.
# VITE_ENABLE_TAMPER_DEMO=false

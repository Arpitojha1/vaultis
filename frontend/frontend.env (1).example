# ============================================================
# VAULTIS Frontend — .env.example
# Copy to .env (Vite reads VITE_-prefixed vars at build/dev time).
# ============================================================

# Base URL of the real backend — no mock data, no fallback.
VITE_API_BASE_URL=http://localhost:8000

# Mirrors the backend's tamper-demo gate, so the frontend can hide
# the "Corrupt a Record" button entirely when the backend endpoint
# is disabled, rather than showing it and getting a 404 live.
VITE_ENABLE_TAMPER_DEMO=false

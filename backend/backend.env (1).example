# ============================================================
# VAULTIS Backend — .env.example
# Copy to .env and fill in real values. Never commit the real .env.
# ============================================================

# --- App ---
APP_ENV=development                 # development | demo | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info                      # debug | info | warning | error

# --- CORS (must include the frontend's dev + demo origins) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- PostgreSQL ---
# Single source of truth for cases, permissions, and the audit chain.
DATABASE_URL=postgresql://vaultis_user:changeme@localhost:5432/vaultis
POSTGRES_USER=vaultis_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=vaultis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth / JWT ---
# Custom JWT + FastAPI middleware. Right-sized for ~5 demo roles, no SSO/MFA.
JWT_SECRET=replace_with_a_long_random_secret_before_first_run
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480               # long-lived for a single demo day

# --- ChromaDB ---
# Used strictly as a search index — never the source of permission truth.
CHROMA_MODE=persistent               # persistent | http
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_HOST=localhost                # only used if CHROMA_MODE=http
CHROMA_PORT=8001                     # only used if CHROMA_MODE=http
CHROMA_COLLECTION_NAME=vaultis_chunks

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu                 # cpu | cuda

# --- Ollama (local LLM — no case data ever leaves the machine) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b              # or llama3.1:8b-instruct-q4_0
OLLAMA_REQUEST_TIMEOUT_SECONDS=60

# --- Chunking (LangChain RecursiveCharacterTextSplitter) ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- File storage / encryption ---
# Encrypt-before-write, decrypt-on-authorized-read. No extra service to run.
STORAGE_DIR=./data/encrypted_files
AES_ENCRYPTION_KEY=replace_with_a_base64_32_byte_key_before_first_run
MAX_UPLOAD_SIZE_MB=25

# --- OCR ---
TESSERACT_CMD=/usr/bin/tesseract     # path to the tesseract binary
OCR_LANGUAGE=eng

# --- Hash chain / audit ---
AUDIT_CHAIN_GENESIS_HASH=GENESIS

# --- Demo-only tamper endpoint (Act 3 of the demo script) ---
# Must be false/unset in any non-demo environment. Hard-disable (404) when false.
ENABLE_TAMPER_DEMO_ENDPOINT=false

# --- Seed data ---
# Controls whether seed.py inserts demo cases/users/documents on startup.
SEED_ON_STARTUP=false

# ============================================================
# Demo accounts
# seed.py reads these at startup (when SEED_ON_STARTUP=true) and
# upserts one user per role with a bcrypt-hashed password. No
# credentials should ever be hardcoded in seed.py itself — this
# is the only place they live, so they can be rotated before
# judging without touching code.
#
# Login flow: POST /auth/login with { username, password }.
# The server determines role from the DB row; the frontend never
# sends a role — see the integration prompt, Section 3.
# ============================================================

DEMO_ACCOUNTS_ENABLED=true

DEMO_IO_USERNAME=officer_demo
DEMO_IO_PASSWORD=ChangeMe_IO_2026!
DEMO_IO_DISPLAY_NAME=Inspector R. Sharma

DEMO_PROSECUTOR_USERNAME=prosecutor_demo
DEMO_PROSECUTOR_PASSWORD=ChangeMe_Pros_2026!
DEMO_PROSECUTOR_DISPLAY_NAME=Adv. K. Iyer (Prosecution)

DEMO_DEFENSE_USERNAME=defense_demo
DEMO_DEFENSE_PASSWORD=ChangeMe_Def_2026!
DEMO_DEFENSE_DISPLAY_NAME=Adv. M. Rao (Defense)

DEMO_JUDGE_USERNAME=judge_demo
DEMO_JUDGE_PASSWORD=ChangeMe_Judge_2026!
DEMO_JUDGE_DISPLAY_NAME=Hon. Justice A. Verma

# Optional fifth account if you want a "fresh/empty vault" demo login
# separate from the seeded cases, to show the Prepare Workspace flow live:
DEMO_NEWUSER_USERNAME=newuser_demo
DEMO_NEWUSER_PASSWORD=ChangeMe_New_2026!
DEMO_NEWUSER_DISPLAY_NAME=Officer T. Nair (New Onboarding)
